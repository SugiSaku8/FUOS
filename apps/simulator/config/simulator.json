{
  "name": "suruga_bay",
  "input": {
    "terrain_source": "suruga_bay.sof/terrain_source.snc",
    "source_bundle": "crates/s-builder/suruga_raw/ocean_source.sosdata"
  },
  "grid": {
    "depth_interval_m": 250.0,
    "deep_velocity_decay_scale_m": 1200.0,
    "terrain_vertical_scale": 5.0,
    "world_scale": 100000.0
  },
  "simulation": {
    "dt_seconds": 0.01,
    "duration_seconds": 60.0,
    "steps_per_frame": 4,
    "steps_per_checkpoint": 600,
    "use_metal": true,
    "kuroshio_inflow": true,
    "scalar_diffusivity_m2_s": 1e-05,
    "horizontal_viscosity_m2_s": 10.0,
    "vertical_viscosity_m2_s": 0.0001,
    "bottom_drag_coefficient": 0.0025
  },
  "render": {
    "enabled": true,
    "show_ocean_surface": true,
    "show_bathymetry_contours": true,
    "contour_interval_m": 250.0,
    "particle_trail_points": 48,
    "particle_speed_multiplier": 240.0,
    "seed_stride_x": 1,
    "seed_stride_y": 1
  },
  "output": {
    "root": "runs/suruga_bay",
    "save_checkpoints": true,
    "save_final": true,
    "resume_from_latest": false
  }
}
